# 선택 사항. google/gemma-4-31B-it는 토큰 없이 받을 수 있다.
# 있으면 Hub rate limit이 올라가 대용량(~62GB) 다운로드가 안정적이고, PUSH_TO_HUB(어댑터 백업)에는 필수다.
# 실제 값은 .env 또는 Pod 환경변수에만 둔다. 코드·번들·로그에 넣지 않는다.
HF_TOKEN=

# 선택: 경로 재정의 (기본값은 저장소 루트 / 그 아래 또는 옆의 data)
# UGRP_ROOT=
# UGRP_DATA_DIR=

# 선택: 테스트에서 다른 repo의 토크나이저를 쓸 때
# UGRP_TOKENIZER_ID=unsloth/gemma-4-31B-it
